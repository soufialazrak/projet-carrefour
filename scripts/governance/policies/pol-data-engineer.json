{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LectureEcritureToutesCouches",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::phenix-bronze/*",
        "arn:aws:s3:::phenix-silver/*",
        "arn:aws:s3:::phenix-gold/*"
      ]
    },
    {
      "Sid": "IndexToutesCouches",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::phenix-bronze",
        "arn:aws:s3:::phenix-silver",
        "arn:aws:s3:::phenix-gold"
      ]
    }
  ]
}
